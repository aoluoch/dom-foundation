# Contentful Content Delivery API credentials
# Space ID for the DOM Trust Foundation space
VITE_CONTENTFUL_SPACE_ID=rcgd7nniu4er

# Contentful environment (defaults to "master")
VITE_CONTENTFUL_ENVIRONMENT=master

# Content Delivery API access token (read-only).
# Create one in Contentful: Settings > API keys > Add API key, then copy the
# "Content Delivery API - access token". Paste it below.
VITE_CONTENTFUL_ACCESS_TOKEN=
